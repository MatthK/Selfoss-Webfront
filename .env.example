# Copy this file to .env and adjust the values before starting the stack.
# Generate passwords e.g. with: openssl rand -base64 24

# MySQL root password (container-internal administration)
MYSQL_ROOT_PASSWORD=change-me-root

# Selfoss application database and user (used by Selfoss AND the webfront)
MYSQL_DATABASE=selfoss
MYSQL_USER=selfoss
MYSQL_PASSWORD=change-me

# Host ports for the newspaper (80) and the selfoss UI (8080)
WEBFRONT_PORT=80
SELFOSS_PORT=8080

# Seconds between automatic selfoss feed updates (0 = disabled)
SELFOSS_UPDATE_INTERVAL=900
